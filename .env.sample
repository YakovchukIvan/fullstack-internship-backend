# ============================================================
# .env.example — template for environment configuration
# Copy this file to .env.development or .env.production
# and fill in the values. Never commit real secrets to git.
# ============================================================

# === Application ============================================
NODE_ENV=                        # development | production
APP_PORT=5000
APP_HOST=0.0.0.0
GLOBAL_PREFIX=api


# === Frontend URLs ============================================
FRONTEND_DEV_URL=http://localhost:3000
FRONTEND_PROD_URL=               # e.g. https://meduzzen-internship.site


# === Database (PostgreSQL) ===================================
# development: localhost with local postgres
# production:  AWS RDS endpoint
POSTGRES_HOST=                   # localhost OR your-db.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=                     # database name
POSTGRES_USER=                   # database user
POSTGRES_PASSWORD=               # database password


# === Redis =============================================
# development: leave REDIS_URL empty, use host/port (local Docker Redis)
# production:  set REDIS_URL from Upstash (rediss://...), ignore host/port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=                       # production only — rediss://default:TOKEN@host:6379


# === JWT =============================================
# Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d


# === Auth0 ============================================
# Get from: https://manage.auth0.com → Applications → your app
AUTH0_DOMAIN=                    # your-tenant.us.auth0.com
AUTH0_ISSUER_URL=                # https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=                  # https://nestjs-backend-api
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=


# === Email (Nodemailer + Gmail) ==================================
# Gmail setup: enable 2FA → myaccount.google.com → App Passwords → generate
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=                      # your Gmail address
EMAIL_PASSWORD=                  # Gmail App Password (16 chars, not your login password)
EMAIL_FROM=                      # same as EMAIL_USER
EMAIL_FROM_NAME=Auth Service


# === Throttler =============================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=5


# === Gemini AI =============================================
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_QUIZ_DAILY_LIMIT=5
GEMINI_MODEL=gemini-2.0-flash


# === File Storage =============================================
# development: STORAGE_TYPE=local  (files saved to UPLOAD_DIR folder)
# production:  STORAGE_TYPE=s3     (files uploaded to AWS S3)
STORAGE_TYPE=                    # local | s3
UPLOAD_DIR=uploads               # used only when STORAGE_TYPE=local


# AWS S3 — required only when STORAGE_TYPE=s3
# Get from: AWS Console → IAM → Users → Security credentials → Access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=                   # e.g. your-app-storage